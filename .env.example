# Replace placeholders with independently generated random values (at least 32 characters).
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters
EXECUTOR_SHARED_TOKEN=replace-with-a-different-32-character-secret
DIFY_MCP_BIND_IP=127.0.0.1

# The gateway is built from the checked-out source by the quick-start command.
# Override with an immutable published image tag only for a controlled release.
ACOUAGENT_GATEWAY_IMAGE=local/acouagent-gateway:source
# The scientific executor remains a prebuilt image because its dependency stack is large.
ACOUAGENT_EXECUTOR_IMAGE=ghcr.io/mwxrookie/acouagent-executor:feat-acouagent-evidence-gates-20261007

# Local orchestration is the clean-install default. The browser selects only a
# profile id; credentials remain in server environment variables.
ORCHESTRATION_BACKEND=local
DEFAULT_MODEL_PROFILE=deepseek-default
MODEL_PROFILES_JSON={"deepseek-default":{"label":"DeepSeek (server)","provider":"openai-compatible","base_url":"https://api.deepseek.com","model":"deepseek-chat","api_key_env":"DEEPSEEK_API_KEY","capabilities":["chat","json","code"]}}
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CODE_RETRY_MAX=7
DIFY_API_KEY=
DIFY_BASE_URL=http://nginx/v1
DIFY_NETWORK_NAME=docker_default
PORTAL_ADMIN_TOKEN=

# Fresh installs expose the reviewed skill library and bootstrap all 17 fixed
# profiles through the existing executor and physical gates. Automatic learning
# remains disabled until the operator explicitly accepts that policy.
SKILL_LIBRARY_ENABLED=true
SKILL_RETRIEVAL_ENABLED=true
SKILL_INJECTION_ENABLED=true
SKILL_MANUAL_INTAKE_ENABLED=true
SKILL_BOOTSTRAP_ALL_FIXED=true
SKILL_LEARNING_ENABLED=false
SKILL_CASE_OBSERVATION_ENABLED=false
