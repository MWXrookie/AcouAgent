# Replace placeholders with independently generated random values (at least 32 characters).
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters
EXECUTOR_SHARED_TOKEN=replace-with-a-different-32-character-secret
DIFY_MCP_BIND_IP=127.0.0.1

# Optional model and Dify integration; no model calls in fixed skill preparation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CODE_RETRY_MAX=7
DIFY_API_KEY=
PORTAL_ADMIN_TOKEN=

# Opt-in skill features. No switch alone certifies a run.
SKILL_LIBRARY_ENABLED=false
SKILL_RETRIEVAL_ENABLED=false
SKILL_INJECTION_ENABLED=false
SKILL_MANUAL_INTAKE_ENABLED=false
SKILL_LEARNING_ENABLED=false
SKILL_CASE_OBSERVATION_ENABLED=false
