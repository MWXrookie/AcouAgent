# Replace placeholders with independently generated random values (at least 32 characters).
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters
EXECUTOR_SHARED_TOKEN=replace-with-a-different-32-character-secret
DIFY_MCP_BIND_IP=127.0.0.1

# The gateway is built from the checked-out source by the quick-start command.
# Override with an immutable published image tag only for a controlled release.
ACOUAGENT_GATEWAY_IMAGE=local/acouagent-gateway:source
# The scientific executor remains a prebuilt image because its dependency stack is large.
ACOUAGENT_EXECUTOR_IMAGE=ghcr.io/mwxrookie/acouagent-executor:f65addf

# Local orchestration is the clean-install default. Configure a reusable model
# here, or enter an expiring BYOK credential in the portal after startup.
ORCHESTRATION_BACKEND=local
# managed: local/jwave_flow use gateway model profiles; self: jwave_flow uses
# its own fixed bridge environment. Dify is always self-managed.
MODEL_CONFIG_MODE=managed
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_LABEL=环境变量模型
MODEL_ALLOW_INSECURE_HTTP=false
DEFAULT_MODEL_PROFILE=
MODEL_PROFILES_JSON=
BYOK_SESSION_TTL_SECONDS=43200
BYOK_ALLOW_PRIVATE_ENDPOINTS=false
MODEL_PRICE_INPUT=0
MODEL_PRICE_INPUT_CACHE=0
MODEL_PRICE_OUTPUT=0
CODE_RETRY_MAX=7
DIFY_API_KEY=
DIFY_BASE_URL=http://nginx/v1
DIFY_NETWORK_NAME=docker_default
# Optional restricted jwave_flow bridge. The ordinary jwave web frontend is not
# a valid target; use deploy/compose.jwave-flow.yaml to build the dedicated bridge.
# The workflow copy is stored under cores/jwave_flow; no external path is used.
JWAVE_FLOW_BASE_URL=
JWAVE_FLOW_BRIDGE_TOKEN=
# Only used when MODEL_CONFIG_MODE=self; managed mode uses MODEL_* profiles.
JWAVE_FLOW_MODEL=
JWAVE_FLOW_API_KEY=
JWAVE_FLOW_OPENAI_BASE_URL=
JWAVE_FLOW_TOP_K=4
JWAVE_FLOW_EXEC_TIMEOUT=30
JWAVE_FLOW_SKILL_MODE=full
JWAVE_FLOW_SKILL_PORT_URL=http://dify-mcp:8001/internal/jwave-flow/skills
# Leave empty to use JWAVE_FLOW_BRIDGE_TOKEN for the internal SkillPort.
JWAVE_FLOW_SKILL_PORT_TOKEN=
JWAVE_FLOW_SKILL_TIMEOUT_SECONDS=2
JWAVE_FLOW_DEADLINE_SECONDS=900
JWAVE_FLOW_READ_TIMEOUT_SECONDS=660
JWAVE_FLOW_MAX_EVENT_BYTES=8388608
PORTAL_ADMIN_TOKEN=
# Comma-separated exact origins for an independently hosted frontend.
PORTAL_ALLOWED_ORIGINS=

# Fresh installs expose the reviewed skill library and bootstrap all 17 fixed
# profiles through the existing executor and physical gates. Automatic learning
# remains disabled until the operator explicitly accepts that policy.
SKILL_LIBRARY_ENABLED=true
SKILL_RETRIEVAL_ENABLED=true
SKILL_INJECTION_ENABLED=true
SKILL_MANUAL_INTAKE_ENABLED=true
SKILL_BOOTSTRAP_ALL_FIXED=true
# Controlled automatic learning also requires authoring, validation and general admission.
SKILL_LEARNING_ENABLED=false
# Manual authoring UI/API; prepare schema18/references first (docs/skills-next/ENABLE_SKILLS.md).
SKILL_AUTHORING_ENABLED=false
# Manual/automatic durable jobs; does not alone enable scientific admission.
SKILL_VALIDATION_ENABLED=false
# Controlled independent validation/admission; requires operator-installed reference assets.
SKILL_GENERAL_ADMISSION_ENABLED=false
SKILL_GENERAL_ASSET_ROOT=/app/data/skill_assets
SKILL_GENERAL_REFERENCE_ROOT=/app/skill-references
SKILL_GENERAL_RUNTIME_SHA256=
SKILL_CASE_OBSERVATION_ENABLED=false
